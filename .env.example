# Copy this file to .env.local for local development.
# In Vercel: Project Settings -> Environment Variables -> add the same keys.
# Never commit .env.local — it is already in .gitignore.

# Base URL of the FastAPI backend (no trailing slash).
# Local:      http://localhost:8000
# Production: https://<your-service>.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Optional. Client-side request timeout in milliseconds.
# Research pipelines can run long, so this defaults high (120s) if unset.
VITE_API_TIMEOUT_MS=120000
